# ============================================================
# SpeakUp — DP World Kigali Safety Reporting System
# Copy to .env and configure. Never commit secrets.
# ============================================================

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# MySQL — local XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=speakup

# Aiven / Vercel (use these instead of DB_* when hosting)
# $env:DATABASE_URL="mysql://avnadmin:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/defaultdb?ssl-mode=REQUIRED"
# DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/defaultdb?ssl-mode=REQUIRED
# DB_SSL=true

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
SESSION_IDLE_MS=1800000

# Mail (SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SpeakUp DP World Kigali <safety@dpworldkigali.com>"
ALERT_SAFETY_MANAGER=safety.manager@dpworldkigali.com
ALERT_OPERATIONS_MANAGER=operations.manager@dpworldkigali.com
ALERT_SECURITY_TEAM=security@dpworldkigali.com

# WhatsApp Business Cloud API (optional)
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_SAFETY_MANAGER=
WHATSAPP_OPERATIONS_MANAGER=
WHATSAPP_SECURITY=

# Uploads
MAX_FILE_SIZE_MB=8
MAX_FILES=6
